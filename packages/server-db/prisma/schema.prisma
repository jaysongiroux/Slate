generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthIdentityType {
  PASSWORD
  OIDC
}

enum AppConfigName {
  ACCOUNT_CREATION_ENABLED
  PASSWORD_AUTH_ENABLED
  STORAGE_BACKEND
  STORAGE_FILESYSTEM_ROOT
  STORAGE_S3_CONFIG
  STORAGE_S3_ENDPOINT
  STORAGE_S3_BUCKET
  STORAGE_S3_ACCESS_KEY_ID
  STORAGE_S3_SECRET_ACCESS_KEY
  GOOGLE_CALENDAR_CLIENT_ID
  GOOGLE_CALENDAR_CLIENT_SECRET
}

enum EmbeddingProvider {
  OPENAI
  OLLAMA
  OPENAI_COMPATIBLE
  ANTHROPIC
}

enum ChatProvider {
  OPENAI
  ANTHROPIC
  OLLAMA
  OPENAI_COMPATIBLE
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  displayName     String
  normalizedUsername String        @unique
  isAdmin         Boolean          @default(false)
  passwordHash    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  identities      AuthIdentity[]
  totpEnrollment  TotpEnrollment?
  documents       Document[]
  diagrams        Diagram[]
  folders         Folder[]
  settings        Setting[]
  attachments     Attachment[]
  aiConfig        AiConfig?
  conversations   Conversation[]
  documentChunks  DocumentChunk[]
  calendarConnections  CalendarConnection[]
  calendarSubscriptions CalendarSubscription[]
  icsSubscriptions     IcsSubscription[]
  contactCache         ContactCache[]
  documentSimilarityEdges DocumentSimilarityEdge[]

  @@index([normalizedUsername])
  @@index([email])
  @@index([isAdmin])
  @@map("user")
}

model Document {
  id          String       @id @default(cuid())
  userId      String
  title       String
  path        String
  content     Json         @default("{}")
  markdown    String       @db.Text @default("")
  deleted     Boolean      @default(false)
  embedded    Boolean      @default(false)
  pinned      Boolean      @default(false)
  isTemplate  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  chunks      DocumentChunk[]
  similarityEdgesFrom DocumentSimilarityEdge[] @relation("SimilarityEdgeFrom")
  similarityEdgesTo   DocumentSimilarityEdge[] @relation("SimilarityEdgeTo")

  @@unique([userId, path])
  @@index([userId, updatedAt])
  @@index([createdAt])
  @@map("document")
}

model Diagram {
  id        String   @id @default(cuid())
  userId    String
  title     String
  scene     Json     @default("{}")
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([userId, deleted])
  @@map("diagram")
}

model Attachment {
  id            String   @id @default(cuid())
  userId        String
  containerType String   // "note" | "diagram"
  containerId   String
  originalName  String
  mimeType      String
  sizeBytes     BigInt
  storageKey    String
  status        String   @default("pending")
  processedKey  String?
  hash          String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([containerType, containerId])
  @@index([status])
  @@index([userId, hash])
  @@map("attachment")
}

model AuthIdentity {
  id                String           @id @default(cuid())
  userId            String
  type              AuthIdentityType
  provider          String
  providerSubject   String
  lastUsedAt        DateTime?
  lastLoginAt       DateTime?
  loginCount        Int              @default(0)
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@index([createdAt])
  @@map("auth_identity")
}

model OidcProviderConfig {
  id                    String   @id @default(cuid())
  providerId            String   @unique
  label                 String
  issuerUrl             String
  clientId              String
  clientSecretEncrypted String
  scopes                String   @default("openid profile email")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([providerId])
  @@index([enabled])
  @@index([createdAt])
  @@map("oidc_provider_config")
}

model OidcAuthRequest {
  id           String   @id @default(cuid())
  state        String   @unique
  providerId   String
  redirectUri  String
  codeVerifier String
  nonce        String
  clientId     String
  isAdmin      Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([providerId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("oidc_auth_request")
}

model TotpEnrollment {
  id           String   @id @default(cuid())
  userId       String   @unique
  secretBase32 String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([createdAt])
  @@map("totp_enrollment")
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, path])
  @@index([userId, updatedAt])
  @@map("folder")
}

model Setting {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, key])
  @@index([userId, updatedAt])
  @@map("setting")
}

model AppConfig {
  name      AppConfigName @id
  value     String        @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([createdAt])
  @@index([updatedAt])
  @@map("app_config")
}

model AiConfig {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  embeddingProvider  EmbeddingProvider?
  embeddingModel     String?
  embeddingEndpoint  String?
  embeddingApiKey    String?
  chatProvider       ChatProvider?
  chatModel          String?
  chatEndpoint       String?
  chatApiKey         String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@map("ai_config")
}

model DocumentChunk {
  id             String                    @id @default(cuid())
  documentId     String
  document       Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String
  user           User                      @relation(fields: [userId], references: [id], onDelete: Restrict)
  chunkIndex     Int
  content        String                    @db.Text
  heading        String?
  embedding      Unsupported("vector(4096)")?
  embeddingModel String
  createdAt      DateTime                  @default(now())

  @@index([userId])
  @@index([documentId])
  @@map("document_chunk")
}

model DocumentSimilarityEdge {
  id             String   @id @default(cuid())
  userId         String
  fromDocumentId String
  toDocumentId   String
  score          Float
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDocument   Document @relation("SimilarityEdgeFrom", fields: [fromDocumentId], references: [id], onDelete: Cascade)
  toDocument     Document @relation("SimilarityEdgeTo", fields: [toDocumentId], references: [id], onDelete: Cascade)

  @@unique([userId, fromDocumentId, toDocumentId])
  @@index([userId])
  @@index([userId, fromDocumentId])
  @@index([userId, toDocumentId])
  @@map("document_similarity_edge")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  title     String?
  summary   String?   @db.Text
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("message")
}

model CalendarConnection {
  id                          String   @id @default(cuid())
  userId                      String
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider                    String   @default("google")
  accountIdentifier           String
  accessTokenEncrypted        String   @db.Text
  refreshTokenEncrypted       String   @db.Text
  tokenExpiresAt              DateTime
  scopes                      String   @default("")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  subscriptions               CalendarSubscription[]

  @@unique([userId, provider, accountIdentifier])
  @@index([userId])
  @@map("calendar_connection")
}

model CalendarSubscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId          String
  connection            CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalCalendarId    String
  name                  String
  color                 String   @default("#7c5cdc")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, connectionId, externalCalendarId])
  @@index([userId])
  @@index([connectionId])
  @@map("calendar_subscription")
}

model IcsSubscription {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  urlEncrypted          String   @map("url")
  urlHash               String?
  name                  String
  color                 String   @default("#7c5cdc")
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([userId, urlHash])
  @@index([userId])
  @@map("ics_subscription")
}

model ContactCache {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email         String
  displayName   String?
  photoUrl      String?
  updatedAt     DateTime @updatedAt

  @@unique([userId, email])
  @@index([userId])
  @@index([updatedAt])
  @@map("contact_cache")
}
