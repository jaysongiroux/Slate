# Copy to apps/core-backend/.env and adjust. Never commit real secrets.
#   cp apps/core-backend/.env.example apps/core-backend/.env
#
# For production / internet-exposed deploys, replace every "replace-me" value
# with a long random secret (e.g. openssl rand -hex 32). See SECURITY.md and
# docs/SELF_HOSTING.md.

# PostgreSQL (matches docker-compose postgres on host port 5435)
DATABASE_URL="postgresql://slate:slate@localhost:5435/slate?schema=public"

# REQUIRED for any non-toy deploy — signs app JWTs (dev fallback: local-dev-secret)
JWT_SECRET="replace-me"

# Encrypts Forge / Jira / Linkwarden / Home Assistant / MCP tokens at rest
# (dev fallback: local-dev-encryption-secret)
ENCRYPTION_SECRET="replace-me"

# Encrypts AI provider API keys at rest (dev fallback: local-dev-ai-key)
AI_ENCRYPTION_KEY="replace-me"

# Encrypts OIDC client secrets at rest (dev fallback: local-dev-oidc-secret)
OIDC_SECRET_ENCRYPTION_KEY="replace-me"

# Encrypts calendar OAuth tokens at rest (dev fallback: local-dev-calendar-secret)
CALENDAR_ENCRYPTION_KEY="replace-me"

# HTTP
PORT=4000
LOG_LEVEL=info

# Optional AdminJS session cookie name (default: slate_admin)
# ADMIN_SESSION_COOKIE_NAME=slate_admin

# Optional embedding job cron (node-cron / pg-boss schedule; default every 10 min)
# EMBEDDING_CRON_INTERVAL=*/10 * * * *

# Google Calendar OAuth (optional; can also be set in Admin → calendar settings)
# Create an OAuth client in Google Cloud Console — see docs/SELF_HOSTING.md
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:4000/api/calendar/oauth/callback

# Attachment storage defaults to <backend-cwd>/data/attachments and is managed
# in Admin → storage (filesystem root or S3). There is no UPLOAD_ROOT env var.
