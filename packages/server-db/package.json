{
  "name": "@slate/server-db",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "npm run prisma:generate",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "npx prisma migrate dev --schema prisma/schema.prisma",
    "prisma:db:execute": "npx prisma db execute --schema prisma/schema.prisma",
    "prisma:db:reset": "npx prisma migrate reset"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "prisma": "^6.5.0"
  }
}
