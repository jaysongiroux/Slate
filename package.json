{
  "name": "slate",
  "version": "0.1.3",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @slate/core-backend",
    "test:core": "npm run test --workspace @slate/core-backend",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "predev:core-backend": "XDG_CACHE_HOME=/tmp npm run db:prisma:generate",
    "dev:core-backend": "npm run start:dev --workspace @slate/core-backend",
    "dev:backend": "npm run dev:core-backend",
    "dev:desktop": "npm run dev --workspace @slate/desktop",
    "desktop:up": "npm run dev --workspace @slate/desktop",
    "desktop:rebuild-native": "npm run rebuild:native --workspace @slate/desktop",
    "db:prisma:generate": "npm run prisma:generate --workspace @slate/server-db",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace @slate/server-db",
    "db:migrate:dev": "npm run prisma:migrate:dev --workspace @slate/server-db",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "core:up": "docker compose up -d core-backend",
    "core:logs": "docker compose logs -f core-backend",
    "stack:up": "docker compose up -d core-backend",
    "stack:logs": "docker compose logs -f core-backend",
    "stack:down": "docker compose down",
    "backend:test": "npm run test:core",
    "postinstall": "node scripts/patch-adminjs-exports.js"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "prettier": "^3.8.1"
  },
  "overrides": {
    "@adminjs/design-system": "4.1.1"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-darwin-x64": "0.34.5",
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@img/sharp-libvips-darwin-x64": "1.2.4",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-linux-x64": "0.34.5",
    "@tailwindcss/oxide-darwin-arm64": "4.2.2",
    "@tailwindcss/oxide-darwin-x64": "4.2.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "@tailwindcss/oxide-win32-x64-msvc": "4.2.2",
    "lightningcss-darwin-arm64": "1.32.0",
    "lightningcss-darwin-x64": "1.32.0",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0",
    "@rollup/rollup-darwin-arm64": "4.59.0",
    "@rollup/rollup-darwin-x64": "4.59.0",
    "@rollup/rollup-linux-x64-gnu": "4.59.0",
    "@rollup/rollup-win32-x64-msvc": "4.59.0"
  },
  "description": "Local-first notes for desktop, with optional self-hosted sync, AI chat, calendars, diagrams, and integrations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaysongiroux/Slate.git"
  },
  "bugs": {
    "url": "https://github.com/jaysongiroux/Slate/issues"
  },
  "homepage": "https://github.com/jaysongiroux/Slate#readme"
}
