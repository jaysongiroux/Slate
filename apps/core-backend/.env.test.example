# Copy to apps/core-backend/.env.test for local backend tests:
#   cp apps/core-backend/.env.test.example apps/core-backend/.env.test
#
# make core-test also sets DATABASE_URL; this file is useful for JWT defaults.
# Create the test DB once:
#   docker compose exec -T postgres psql -U slate -d slate -c 'CREATE DATABASE slate_test OWNER slate;'

TEST_DATABASE_URL="postgresql://slate:slate@localhost:5435/slate_test?schema=public"

JWT_SECRET="replace-me"
ENCRYPTION_SECRET="replace-me"
AI_ENCRYPTION_KEY="replace-me"
OIDC_SECRET_ENCRYPTION_KEY="replace-me"
CALENDAR_ENCRYPTION_KEY="replace-me"
