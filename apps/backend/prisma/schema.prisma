generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthIdentityType {
  PASSWORD
  OIDC
}

enum WorkspaceRole {
  OWNER
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  displayName     String
  passwordHash    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspacesOwned Workspace[]      @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  identities      AuthIdentity[]
  totpEnrollment  TotpEnrollment?
  documentsOwned  Document[]       @relation("DocumentOwner")
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  ownerUserId String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation("WorkspaceOwner", fields: [ownerUserId], references: [id])
  members     WorkspaceMember[]
  documents   Document[]
  attachments Attachment[]
  clients     ClientBinding[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(OWNER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
}

model Document {
  id               String       @id @default(cuid())
  workspaceId      String
  ownerUserId      String
  title            String
  path             String
  markdown         String       @db.Text
  plainText        String       @db.Text
  deleted          Boolean      @default(false)
  acceptedRevision BigInt       @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  workspace        Workspace    @relation(fields: [workspaceId], references: [id])
  owner            User         @relation("DocumentOwner", fields: [ownerUserId], references: [id])
  attachments      Attachment[]

  @@unique([workspaceId, path])
  @@index([workspaceId, acceptedRevision])
}

model Attachment {
  id           String   @id @default(cuid())
  workspaceId  String
  documentId   String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  storageKey   String
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  document     Document  @relation(fields: [documentId], references: [id])
}

model AuthIdentity {
  id                String           @id @default(cuid())
  userId            String
  type              AuthIdentityType
  provider          String
  providerSubject   String
  createdAt         DateTime         @default(now())
  user              User             @relation(fields: [userId], references: [id])

  @@unique([provider, providerSubject])
}

model TotpEnrollment {
  id           String   @id @default(cuid())
  userId       String   @unique
  secretBase32 String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model ClientBinding {
  id               String   @id @default(cuid())
  workspaceId      String
  clientId         String
  lastSeenRevision BigInt   @default(0)
  updatedAt        DateTime @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, clientId])
}

