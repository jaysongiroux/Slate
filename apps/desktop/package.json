{
  "name": "@slate/desktop",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "predev": "npm run build --workspace @slate/shared",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:1420 && cross-env VITE_DEV_SERVER_URL=http://localhost:1420 electron electron/main.mjs",
    "prebuild": "npm run build --workspace @slate/shared",
    "build": "tsc --noEmit && vite build",
    "test": "node --test electron/services/*.test.mjs",
    "prelint": "npm run build --workspace @slate/shared",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "rebuild:native": "echo 'No Electron native rebuild required'",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@grpc/grpc-js": "^1.12.5",
    "@grpc/proto-loader": "^0.7.13",
    "@milkdown/core": "^7.19.0",
    "@milkdown/ctx": "^7.19.0",
    "@milkdown/plugin-clipboard": "^7.19.0",
    "@milkdown/plugin-history": "^7.19.0",
    "@milkdown/plugin-prism": "^7.19.0",
    "@milkdown/plugin-slash": "^7.19.0",
    "@milkdown/preset-commonmark": "^7.19.0",
    "@milkdown/preset-gfm": "^7.19.0",
    "@milkdown/prose": "^7.19.0",
    "@milkdown/utils": "^7.19.0",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "chokidar": "^4.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "dompurify": "^3.3.3",
    "fast-glob": "^3.3.3",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.13.0",
    "motion": "^12.38.0",
    "prismjs": "^1.30.0",
    "react": "^19.0.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "35.1.5",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.slate.app",
    "productName": "Slate",
    "icon": "build/icon.png",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
